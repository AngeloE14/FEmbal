# ===== DOCUMENT MODULE =====
# API de correo del documento. En desarrollo, Vite proxya /api/documents/email
# hacia http://127.0.0.1:4180 cuando ejecutas npm run certificate:email-api.

EMAIL_API_PORT=4180
EMAIL_API_ALLOWED_ORIGIN=http://127.0.0.1:4173

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario@example.com
SMTP_PASS=app-password
SMTP_FROM=ESAMS <usuario@example.com>

# Opcional si el frontend llama a una API externa en producción:
# VITE_DOCUMENT_EMAIL_API_URL=https://tu-dominio.com/api/documents/email
